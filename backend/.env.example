# Copy to .env and fill in as needed. The app runs fully without any of these
# (AI explanations fall back to templated text, DB falls back to in-memory SQLite).

# Optional: Google Gemini API key. When set, Gemini is used to generate
# plain-English explanations of already-detected rings (preferred provider).
# AI explanations are generated after the entire transaction stream completes
# (template explanations are shown during streaming to avoid API calls).
# Get a key at https://aistudio.google.com/apikey. Never commit the real key.
GEMINI_API_KEY="GEMINI_API_KEY_PLACEHOLDER"
GEMINI_MODEL=gemini-2.0-flash

# Optional: OpenAI-compatible endpoint used ONLY to generate plain-English
# explanations of already-detected rings. Used when GEMINI_API_KEY is unset.
# Never used for detection or decisions.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# SQLite file path. If the directory is not writable, the app automatically
# falls back to an in-memory database and logs a warning.
DATABASE_PATH=./data/fraud_sentinel.db

# Synthetic stream replay speed: transactions emitted per second by the
# background streamer.
STREAM_TPS=15

# Detection re-run cadence: re-run ring detection every N new edges.
DETECTION_EVERY_N_EDGES=30

# CORS origin for the frontend dev server.
FRONTEND_ORIGIN=http://localhost:3000
